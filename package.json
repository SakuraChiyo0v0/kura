{
  "name": "kura",
  "productName": "Kura",
  "version": "0.1.0",
  "private": true,
  "description": "Kura 蔵 —— 绿联 NAS 的 Windows 桌面客户端",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "smoke": "node build.mjs && node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run smoke"
  },
  "dependencies": {
    "@sakura-ui/electron": "file:./vendor/sakura-ui/sakura-ui-electron-0.1.0.tgz",
    "@sakura-ui/electron-react": "file:./vendor/sakura-ui/sakura-ui-electron-react-0.1.0.tgz",
    "@sakura-ui/react": "file:./vendor/sakura-ui/sakura-ui-react-0.1.0.tgz",
    "@sakura-ui/tokens": "file:./vendor/sakura-ui/sakura-ui-tokens-0.1.0.tgz",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "esbuild": "0.27.7",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.27.7": true
  }
}
