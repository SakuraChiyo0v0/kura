{
  "name": "kura",
  "productName": "Kura",
  "version": "0.9.6",
  "private": true,
  "description": "Kura 蔵 —— 绿联 NAS 的 Windows 桌面客户端",
  "author": "SakuraChiyo0v0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "smoke": "node build.mjs && node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && node server/build.mjs && npm test && npm run smoke",
    "dist": "node build.mjs && node scripts/release-notes.mjs && electron-builder --win --x64 --publish never",
    "icon": "node scripts/make-icon.mjs",
    "server:build": "node server/build.mjs",
    "server:start": "node server/build.mjs && node dist/server/main.mjs"
  },
  "dependencies": {
    "@sakura-ui/electron": "file:./vendor/sakura-ui/sakura-ui-electron-0.2.2.tgz",
    "@sakura-ui/electron-react": "file:./vendor/sakura-ui/sakura-ui-electron-react-0.2.2.tgz",
    "@sakura-ui/react": "file:./vendor/sakura-ui/sakura-ui-react-0.2.2.tgz",
    "@sakura-ui/tokens": "file:./vendor/sakura-ui/sakura-ui-tokens-0.2.2.tgz",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.10",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.27.7",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.27.7": true
  }
}
