# 复制成 .env，和 docker-compose.yaml 放同一目录。权限建议 600。

# 登录用户名（客户端「网关账号」填这个）
KURA_USER=

# 密码的 argon2id 哈希。生成：
#   docker run --rm -it kura-server hash
# 现网 sso-gateway 的 ADMIN_PASSWORD_HASH 可以原样搬过来。
# 注意：compose 会对 .env 插值，哈希里的 $ 会被展开成空串，所以要用单引号把整串包起来：
#   KURA_PASSWORD_HASH='$argon2id$v=19$m=…'
# （单引号的值 compose 不插值；写成 $$ 逐个转义也行，但难看。）
KURA_PASSWORD_HASH=

# 可选：查容器端口映射（清单里的 published），需要挂 docker.sock
# KURA_DOCKER_SOCKET=/var/run/docker.sock

# 终端（compose 里已设好，一般不用改）：
# KURA_SHELL=http://kura-shell:8890
# KURA_SHELL_TOKEN_FILE=/run/kura-shell/token
